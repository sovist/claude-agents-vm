# Settings for this agents VM. Copy to config.env and fill in; every script reads config.env.
# Shell syntax: NAME=value, quotes around values with spaces. No secrets here: tokens go into secrets/
# with save-secret.sh. Stack-specific settings (base image, build tools, extra mounts) belong in project/,
# see docs/project-hooks.md.

# The repository every new agent clones into its workspace (HTTPS; the token in secrets/git-token is used).
REPO_URL=https://github.com/you/your-repo.git

# Git over HTTPS: the host of REPO_URL, and the user name that goes with the token in secrets/git-token:
#   github.com     x-access-token               (fine-grained or classic personal access token)
#   bitbucket.org  x-bitbucket-api-token-auth   (Atlassian API token with Bitbucket scopes)
#                  x-token-auth                 (Bitbucket repository access token)
#   gitlab.com     oauth2                       (personal or project access token)
GIT_HOST=github.com
GIT_HOST_USERNAME=x-access-token

# The name and email the agents' commits are authored with. Environment variables, so they win over any
# "git config user.*" an agent runs. Use your own to have agents commit as you.
AGENT_GIT_NAME="Your Name"
AGENT_GIT_EMAIL=you@example.com

# Optional: read-only Jira and Confluence for the agents (the jira and confluence commands) and for the
# task board's Jira autofill. Leave empty to turn them off. The cloud id is public; get it with:
#   curl -s https://<your-site>.atlassian.net/_edge/tenant_info
ATLASSIAN_SITE=
ATLASSIAN_CLOUD_ID=

# Time zone vm/setup.sh sets on the VM (timedatectl list-timezones); empty keeps the current one.
TZ_NAME=

# Minutes without a Rider window connected before an agent's Rider backend is stopped.
RIDER_IDLE_MINUTES=10

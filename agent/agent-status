#!/usr/bin/env bash
# Claude Code hook: records this agent's state for "agents.sh list" on the VM.
# Called by the hooks in /etc/claude-code/managed-settings.json as: agent-status <state>
# Writes one line to /run/agent-status/state (mounted from ~/agents/.status/<name>):
#   <state> TAB <unix time> TAB <detail>
# and, when a turn ends, Claude's whole final reply to /run/agent-status/reply (read by the agents MCP server).
# Prints nothing, because the output of some hooks is added to Claude's context, and always exits 0,
# so a status problem can never block Claude.
dir=/run/agent-status
[ -d "$dir" ] && [ -w "$dir" ] || exit 0

state="${1:-unknown}"
input="$(cat 2>/dev/null || true)"
detail=

case "$state" in
    needs-you)
        detail="$(jq -r '.message // empty' <<<"$input" 2>/dev/null)"
        if [[ "$detail" == *"waiting for your input"* ]]; then
            # Claude Code's idle reminder, a minute after a turn, isn't a question: keep done, ready or a real
            # needs-you, with the detail they carry. After an interrupted turn (Esc), which leaves "working"
            # behind, it means the agent is at its prompt again: ready.
            case "$(cut -f1 "$dir/state" 2>/dev/null)" in done|ready|needs-you) exit 0 ;; esac
            state=ready
            detail=
        fi
        ;;
    done)
        # Claude's final reply. The Stop hook's input carries it; the transcript is only a fallback, since
        # the reply isn't written to it yet. The state line keeps the last line, e.g. the question it ends with.
        reply="$(jq -r '.last_assistant_message // empty
                        | if type == "string" then . else ([.content[]? | select(.type == "text") | .text] | join("\n")) end' \
                    <<<"$input" 2>/dev/null)"
        transcript="$(jq -r '.transcript_path // empty' <<<"$input" 2>/dev/null)"
        if [ -z "$(tr -d '[:space:]' <<<"$reply")" ] && [ -r "$transcript" ]; then
            reply="$(tail -n 50 "$transcript" \
                | jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "text") | .text' 2>/dev/null)"
        fi
        detail="$(grep -v '^[[:space:]]*$' <<<"$reply" | tail -n 1)"
        printf '%s\n' "$reply" | head -c 65536 > "$dir/reply.tmp" 2>/dev/null && mv -f "$dir/reply.tmp" "$dir/reply" 2>/dev/null
        ;;
    ended)
        # Keep the summary of the last turn, so a finished agent still shows what it ended with.
        detail="$(cut -f3 "$dir/state" 2>/dev/null)"
        ;;
esac

detail="$(printf '%s' "$detail" | tr '\t\r\n' '   ' | cut -c1-200)"
printf '%s\t%s\t%s\n' "$state" "$(date +%s)" "$detail" > "$dir/state.tmp" 2>/dev/null \
    && mv "$dir/state.tmp" "$dir/state" 2>/dev/null
exit 0
